      "redirectUris": ["http://localhost:5173/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3001/*"
      }
    },
    {
      "clientId": "warroom-cli",
      "name": "Scripts and API tests (password grant, local only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,

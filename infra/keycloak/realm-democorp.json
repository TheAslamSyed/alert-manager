    "realm": [
      { "name": "VIEWER", "description": "Read incidents and summaries" },
      { "name": "RESPONDER", "description": "Investigate, propose fixes, draft messages" },
      { "name": "APPROVER", "description": "Approve fixes and outgoing messages" },
      { "name": "ADMIN", "description": "Manage settings; cannot approve fixes" }
    ]
  },
  "clients": [
